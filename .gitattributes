# Normalize text line endings to LF
* text=auto eol=lf

# Rust Sources & Configs
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary Formats
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gz binary
